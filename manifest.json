{
  "manifest_version": 3,
  "name": "X Video Resume – Continue Videos & Wide Mode",
  "version": "2.1",
  "description": "Resume X (Twitter) videos where you left off, with sound settings remembered. Plus Wide Mode for a full-width timeline. 100% local.",
  "permissions": ["storage"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Video Resume Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.x.com/*",
        "https://pro.x.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
